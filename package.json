{
  "name": "agent-town",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "parse": "node scripts/parse.ts",
    "test": "vitest run",
    "dev": "cd packages/web && ./node_modules/.bin/vite",
    "build": "cd packages/web && ../../node_modules/.bin/tsc --noEmit -p . && ./node_modules/.bin/vite build",
    "e2e": "cd packages/web && ./node_modules/.bin/playwright test",
    "serve": "node scripts/serve.ts",
    "start": "node --run build && node scripts/serve.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
